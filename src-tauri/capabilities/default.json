{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "M3 授权集——按 ACL 报错驱动逐项最小化放行；M1 起 core:default 全家桶禁用",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:tray:default",
    "core:menu:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-hide",
    "core:window:allow-close",
    "log:default",
    "notification:default"
  ]
}
