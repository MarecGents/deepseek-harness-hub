{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "M4 授权集——按 ACL 报错驱动逐项最小化放行；M1 起 core:default 全家桶禁用",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:event:default",
    "core:tray:default",
    "core:menu:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "log:default",
    "notification:default",
    "allow-ping",
    "allow-diag-report",
    "allow-set-window-theme",
    "allow-set-window-size",
    "allow-get-workspace-path",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-close",
    "allow-tray-quit",
    "allow-tray-menu-closed",
    "allow-window-toggle-visible",
    "allow-play-sound",
    "allow-open-workspace-path",
    "allow-notify-task-complete"
  ]
}
