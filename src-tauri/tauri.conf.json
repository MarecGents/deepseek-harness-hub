{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Hub",
  "version": "0.1.4",
  "identifier": "com.marecgents.dsh-hub",
  "build": {
    "frontendDist": "../dev/index.html",
    "devUrl": "http://127.0.0.1:17891",
    "beforeDevCommand": "node scripts/dev-shell-page.mjs",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [],
    "resources": [
      "../scripts/dsh-deps-install.ps1",
      "../scripts/uninstall-cleanup.ps1",
      "../scripts/assemble-profile.mjs",
      "../package.json",
      "../cordis.patch.yml",
      "../lib/**/*",
      "../assets/**/*",
      "../bin/**/*",
      "../node_modules/@deepseek-ai/cordis/**/*",
      "../node_modules/@deepseek-ai/cordis-plugin-include/**/*",
      "../node_modules/@deepseek-ai/cordis-plugin-loader/**/*",
      "../node_modules/@deepseek-ai/cosmokit/**/*",
      "../node_modules/@deepseek-ai/dsh-brand/**/*",
      "../node_modules/@deepseek-ai/dsh-invariants/**/*",
      "../node_modules/@deepseek-ai/dsh-settings/**/*",
      "../node_modules/@deepseek-ai/schemastery/**/*",
      "../node_modules/@standard-schema/spec/**/*",
      "../node_modules/argparse/**/*",
      "../node_modules/js-yaml/**/*",
      "../node_modules/node-pty/**/*",
      "../plugins/**/*",
      "icons/*.ico"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsi"
      }
    }
  }
}
