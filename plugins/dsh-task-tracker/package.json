{
  "name": "@dsh-external/dsh-task-tracker",
  "version": "0.0.1",
  "description": "任务状态追踪（TASKS.md 注入上下文 + task_create/update/complete/list 工具，解决长对话中模型丢失任务状态的问题）",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check lib/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
