{
  "name": "@dsh-external/dsh-project-memory",
  "version": "0.0.2",
  "description": "每项目持久记忆（MEMORY.md 索引 + memories/<slug>.md 单记忆文件 + FACT.md + JOURNAL.jsonl，自动注入 systemPrompt.context + memory_save/read/log/fact 工具）",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check lib/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
