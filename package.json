{
  "name": "marec-dsh-desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness desktop shell + feature plugin integration. Launches dsh's Web UI in a native WebView2 window with theme sync and window-state memory; injects the plugin config page only when started by this project (desktop shortcut or `mg-dsh` command).",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "bin",
    "scripts",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "bin": {
    "mg-dsh": "bin/mg-dsh.mjs"
  },
  "scripts": {
    "build": "tsc",
    "build:client": "node ./scripts/build-client.mjs",
    "generate:icons": "node ./scripts/generate-icon.mjs",
    "prepack": "npm run build && npm run build:client",
    "postinstall": "node ./scripts/postinstall.mjs",
    "postuninstall": "node ./scripts/postuninstall.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@webviewjs/webview": "^0.4.2",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-cmdline": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-mcp-client": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-cmdline": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-settings": "^0.0.1-rc.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-mcp-client": "^0.0.1-rc.1"
  }
}